# ==============================================================================
# MEHAR B2B Platform - Environment Variables Template
# Copy this file to .env and provide your environment-specific configuration.
# DO NOT commit real secrets or credentials to source control.
# ==============================================================================

# Database Configuration (PostgreSQL Required)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/mehar_db?schema=public
DIRECT_URL=postgresql://postgres:password@localhost:5432/mehar_db?schema=public

# Authentication & Session Security (Generate a secure 64-char random string)
JWT_SECRET=your_jwt_secret_key_here_min_32_characters

# Application URLs & Identification
NEXT_PUBLIC_SITE_URL=https://www.meharbatteries.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="Lawad Infrastructure Private Limited"
NEXT_PUBLIC_BRAND_NAME="MEHAR"

# B2B Contact & Communication Channels
NEXT_PUBLIC_SALES_EMAIL=sales@meharbatteries.com
NEXT_PUBLIC_WHATSAPP_NUMBER=+91XXXXXXXXXX
ADMIN_NOTIFICATION_EMAIL=leads@lawadinfrastructure.com

# SMTP Transactional Email Settings (Optional / For Lead Alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=no-reply@meharbatteries.com

# Document & Attachment Storage
STORAGE_PROVIDER=local
UPLOAD_DIR=./public/uploads

# Optional S3 / Cloudflare R2 Credentials (for Production Cloud Storage)
S3_BUCKET_NAME=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=ap-south-1
